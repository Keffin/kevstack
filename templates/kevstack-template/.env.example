# Shared by apps/api and packages/db (drizzle-kit). Copy to .env
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kevstack_template

# API
PORT=4000
CLIENT_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:4000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
